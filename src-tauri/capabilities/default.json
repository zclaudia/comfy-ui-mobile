{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile-main",
  "description": "Minimal network capabilities required by the Android Gateway client.",
  "windows": [
    "main"
  ],
  "platforms": [
    "android"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*:*/*"
        },
        {
          "url": "https://*/*"
        },
        {
          "url": "http://127.0.0.1:*/*"
        },
        {
          "url": "http://localhost:*/*"
        },
        {
          "url": "http://:host((?:10(?:\\.[0-9]{1,3}){3}|192\\.168(?:\\.[0-9]{1,3}){2}|172\\.(?:1[6-9]|2[0-9]|3[01])(?:\\.[0-9]{1,3}){2})):*/*"
        }
      ]
    },
    "media-download:default",
    "secure-credentials:default",
    "websocket:default",
    "clipboard-manager:allow-write-text"
  ]
}
