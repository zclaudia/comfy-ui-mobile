{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Comfy Mobile",
  "version": "0.3.0",
  "identifier": "app.comfymobile.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Comfy Mobile",
        "width": 430,
        "height": 932,
        "minWidth": 320,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocolasset: asset:; connect-src 'self' ipc: http://ipc.localhost http: https: ws: wss:; img-src 'self' customprotocolasset: asset: data: blob: http: https:; media-src 'self' customprotocolasset: asset: data: blob: http: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../public/icons/comfy-mobile-app-icon-v4-1024x1024.png"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 2,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
