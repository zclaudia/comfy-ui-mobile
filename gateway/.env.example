# Public listener. Put TLS in front of the Gateway for non-LAN deployments.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ComfyUI is an internal upstream and should not be exposed to mobile devices.
COMFYUI_URL=http://192.168.2.150:8188

# Required by default. Use a long, random value (for example: openssl rand -hex 32).
GATEWAY_AUTH_TOKEN=replace-with-a-long-random-token
GATEWAY_SESSION_SECRET=replace-with-an-independent-random-secret

# Revocable Android device credentials. Persist this file across deployments.
GATEWAY_DEVICE_STORE=gateway/.data/devices.json
GATEWAY_DEVICE_TOKEN_TTL_SECONDS=15552000

# ComfyUI-Login upstream token, only when the internal ComfyUI uses it.
COMFYUI_AUTH_TOKEN=

# Optional migration bridge for the legacy 9188 launcher. It remains internal.
COMFYUI_LAUNCHER_URL=

# Development escape hatch only. Do not enable on an exposed network.
GATEWAY_ALLOW_ANONYMOUS=false

# Destructive/admin operations are denied unless explicitly enabled.
GATEWAY_ALLOW_DANGEROUS_ACTIONS=false

# Production UI build served by the Gateway.
GATEWAY_STATIC_DIR=dist

# Comma-separated extra browser origins for split-origin development.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://tauri.localhost
GATEWAY_SECURE_COOKIES=false
# Same-site policy for the session cookie. Cross-origin clients (Tauri app at
# tauri.localhost, split-origin development) need "none"; same-origin hosting
# should keep the default "strict". "none" forces the Secure attribute.
GATEWAY_COOKIE_SAMESITE=strict
GATEWAY_TRUST_PROXY=false
# Workflow agent MVP (Node >=22.13; npm run build:agent before direct node startup).
# Enable the UI/backend without credentials; it will report providerReady=false.
GATEWAY_AGENT_ENABLED=false
GATEWAY_AGENT_STORE=gateway/.data/agent.sqlite
# OpenAI-compatible Chat Completions endpoint, including /v1 where required.
AGENT_LLM_BASE_URL=
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
# Send images the user attaches in chat to the model as vision input (the model must accept image input; set false for text-only models).
AGENT_LLM_VISION=true
# Bootstrap only: after first initialization, manage these per model in App → Chats → Assistant models.
AGENT_LLM_CONTEXT_WINDOW=32768
AGENT_LLM_MAX_OUTPUT_TOKENS=2500
AGENT_MAX_STEPS=12
AGENT_MAX_PREVIEWS=3
AGENT_TIMEOUT_MS=1200000
AGENT_POLL_MS=1500
# Multi-draft workspace. The chat keeps independent drafts, durable assets and Run records; there is no other mode.
# AGENT_WORKSPACE_SERVER_ID identifies the ComfyUI server behind this Gateway, is required whenever the assistant is
# enabled, and is permanent once drafts exist: changing it invalidates stored source references and library-save targets.
AGENT_WORKSPACE_SERVER_ID=main-comfy
# Durable copies of generated and uploaded media. Defaults to assets/ next to GATEWAY_AGENT_STORE.
AGENT_WORKSPACE_MEDIA_DIR=gateway/.data/assets
