# Public listener. Put TLS in front of the Gateway for non-LAN deployments.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ComfyUI is an internal upstream and should not be exposed to mobile devices.
COMFYUI_URL=http://192.168.2.150:8188

# Required by default. Use a long, random value (for example: openssl rand -hex 32).
GATEWAY_AUTH_TOKEN=replace-with-a-long-random-token
GATEWAY_SESSION_SECRET=replace-with-an-independent-random-secret

# ComfyUI-Login upstream token, only when the internal ComfyUI uses it.
COMFYUI_AUTH_TOKEN=

# Optional migration bridge for the legacy 9188 launcher. It remains internal.
COMFYUI_LAUNCHER_URL=

# Development escape hatch only. Do not enable on an exposed network.
GATEWAY_ALLOW_ANONYMOUS=false

# Destructive/admin operations are denied unless explicitly enabled.
GATEWAY_ALLOW_DANGEROUS_ACTIONS=false

# Production UI build served by the Gateway.
GATEWAY_STATIC_DIR=dist

# Comma-separated extra browser origins for split-origin development.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
GATEWAY_SECURE_COOKIES=false
GATEWAY_TRUST_PROXY=false
