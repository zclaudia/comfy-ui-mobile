{
  "name": "comfy-mobile-ui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gateway": "npm run build:agent && node --env-file-if-exists=gateway/.env gateway/index.js",
    "test:gateway": "node --test gateway/test/*.test.js",
    "test:e2e:live": "node --env-file=gateway/.env --test tests/e2e/live-gateway.test.mjs",
    "test:e2e:manual": "node --test tests/e2e/manual-workflows-live.test.mjs",
    "test:e2e:cloud": "node --test tests/e2e/cloud-workflow-live.test.mjs",
    "build": "tsc -b && vite build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate-icons": "tauri icon public/icons/comfy-mobile-app-icon-v4-1024x1024.png",
    "deploy": "node scripts/deploy.js",
    "build:deploy": "npm run build && npm run deploy",
    "test:e2e:android": "node tests/e2e/android-emulator.e2e.mjs",
    "test:e2e:cloud:android": "node tests/e2e/cloud-workflow-android.e2e.mjs",
    "prepare:manual:android": "node tests/e2e/prepare-manual-test-emulator.mjs",
    "build:agent": "tsc -p gateway/tsconfig.json",
    "migrate:agent-workspace": "npm run build:agent && node gateway/dist/agent/workspace/migrateCli.js",
    "test:agent": "npm run build:agent && tsx --test gateway/workflow/test/*.test.ts gateway/agent/test/*.test.ts",
    "test:e2e:agent": "node --test tests/e2e/agent-live.test.mjs",
    "test:e2e:models": "node tests/e2e/model-adaptation-live.mjs",
    "test:transcript": "tsx --test tests/transcript/*.test.ts",
    "test:agent-ui": "tsx --tsconfig tsconfig.app.json --test tests/agent/*.test.ts",
    "test:e2e:form:android": "node tests/e2e/form-view-android.e2e.mjs"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-collapsible": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-websocket": "^2.4.2",
    "@types/ws": "^8.18.1",
    "@zclaudia/agent-transcript-kit": "0.8.0",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.12",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^0.534.0",
    "postcss": "^8.5.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^16.5.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.7.1",
    "react-zoom-pan-pinch": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "swiper": "^14.0.2",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6",
    "workbox-window": "^7.3.0",
    "ws": "^8.18.3",
    "zod": "^3.24.1",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "0.25.8",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "shadcn": "^2.2.0",
    "sharp": "^0.34.3",
    "tailwindcss": "^4.1.11",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4"
  }
}
